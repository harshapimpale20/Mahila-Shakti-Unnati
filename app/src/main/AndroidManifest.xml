<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Essential Permissions for Internet and Media -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Mahila Shakti Unnati"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"

        tools:targetApi="33">

        <!-- 1. ENTRY POINT -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. AUTHENTICATION -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <!-- 3. MAIN HUB (Dashboard) -->
        <activity
            android:name=".DashboardActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <!-- 4. MEMBER MANAGEMENT -->
        <activity
            android:name=".MemberDirectoryActivity"
            android:exported="false" />

        <!-- 5. SAVINGS MODULE (Updated for History and Entry) -->
        <activity
            android:name=".SavingEntryActivity"
            android:exported="false"
            android:label="Add Saving Entry" />
        <activity
            android:name=".SavingHistoryActivity"
            android:exported="false"
            android:label="Savings History" />

        <!-- 6. LOAN MANAGEMENT -->
        <activity
            android:name=".LoanRequestActivity"
            android:exported="false"
            android:label="Request Loan" />
        <activity
            android:name=".LoanTrackerActivity"
            android:exported="false" />

        <!-- 7. INFORMATION, PROFILE & REPORTS -->
        <activity
            android:name=".ReportsActivity"
            android:exported="false"
            android:label="Reports" />
        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:label="My Profile" />

        <activity
            android:name=".GroupDetailsActivity"
            android:exported="false" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

    </application>

</manifest>